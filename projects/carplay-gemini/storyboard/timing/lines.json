[
 {
  "line": 1,
  "text": "CarPlay 怎麼用 Gemini？",
  "start": 0.6,
  "end": 2.1
 },
 {
  "line": 2,
  "text": "四個步驟，第三步最常被漏掉。",
  "start": 2.5,
  "end": 5.5
 },
 {
  "line": 3,
  "text": "Google 十一月十一號宣布：",
  "start": 5.9,
  "end": 8.15
 },
 {
  "line": 4,
  "text": "Gemini 上 CarPlay 了。",
  "start": 8.55,
  "end": 10.05
 },
 {
  "line": 5,
  "text": "開車時用講的，就能問行程、聽未讀信。",
  "start": 10.45,
  "end": 14.2
 },
 {
  "line": 6,
  "text": "第一步，Gemini 更新到最新版。",
  "start": 14.6,
  "end": 17.1
 },
 {
  "line": 7,
  "text": "第二步，打開麥克風權限。",
  "start": 17.5,
  "end": 20.0
 },
 {
  "line": 8,
  "text": "第三步，先在手機用一次 Gemini Live。",
  "start": 20.4,
  "end": 23.4
 },
 {
  "line": 9,
  "text": "官方列為必要步驟，不是建議。",
  "start": 23.8,
  "end": 26.8
 },
 {
  "line": 10,
  "text": "第四步，接上車，點螢幕上的 Gemini。",
  "start": 27.2,
  "end": 30.2
 },
 {
  "line": 11,
  "text": "台灣可以用，中文也能講。",
  "start": 30.6,
  "end": 33.1
 },
 {
  "line": 12,
  "text": "功能分批開放，沒看到就過幾天再看。",
  "start": 33.5,
  "end": 37.25
 },
 {
  "line": 13,
  "text": "我是董達達。",
  "start": 37.65,
  "end": 39.15
 },
 {
  "line": 14,
  "text": "想看更多 AI 和 3C 的白話解說嗎？",
  "start": 39.55,
  "end": 43.05
 },
 {
  "line": 15,
  "text": "追蹤 @dada3c.tw，新功能第一時間講給你聽！",
  "start": 43.45,
  "end": 47.7
 }
]